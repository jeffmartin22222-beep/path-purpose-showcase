{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Path + Purpose approved lesson manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "lessons"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "lessons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "grade",
          "subject",
          "course",
          "unit",
          "version",
          "entry",
          "qa"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "grade": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          },
          "course": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "entry": {
            "type": "string"
          },
          "qa": {
            "type": "object",
            "required": [
              "content",
              "pedagogy",
              "technical",
              "experience"
            ],
            "properties": {
              "content": {
                "type": "object",
                "required": [
                  "status",
                  "evidence"
                ],
                "properties": {
                  "status": {
                    "const": "passed"
                  },
                  "evidence": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "pedagogy": {
                "type": "object",
                "required": [
                  "status",
                  "evidence"
                ],
                "properties": {
                  "status": {
                    "const": "passed"
                  },
                  "evidence": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "technical": {
                "type": "object",
                "required": [
                  "status",
                  "evidence"
                ],
                "properties": {
                  "status": {
                    "const": "passed"
                  },
                  "evidence": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "experience": {
                "type": "object",
                "required": [
                  "status",
                  "evidence"
                ],
                "properties": {
                  "status": {
                    "const": "passed"
                  },
                  "evidence": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
