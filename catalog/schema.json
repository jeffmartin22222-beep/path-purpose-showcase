{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Path + Purpose approved lesson catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "lessons"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "generatedAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "lessons": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/lesson"
      }
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "attestation": {
      "type": "object",
      "required": [
        "reviewedBy",
        "reviewedAt"
      ],
      "properties": {
        "reviewedBy": {
          "type": "string",
          "minLength": 1
        },
        "reviewedAt": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "gate": {
      "type": "object",
      "required": [
        "status",
        "reviewedBy",
        "reviewedAt",
        "evidence"
      ],
      "properties": {
        "status": {
          "const": "passed"
        },
        "reviewedBy": {
          "type": "string",
          "minLength": 1
        },
        "reviewedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "lesson": {
      "type": "object",
      "required": [
        "id",
        "title",
        "grade",
        "subject",
        "course",
        "unit",
        "version",
        "entry",
        "sha256",
        "rights",
        "qa"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "grade": {
          "type": "string",
          "minLength": 1
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "course": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "entry": {
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/sha"
        },
        "rights": {
          "type": "object",
          "required": [
            "status",
            "basis",
            "notes",
            "reviewedBy",
            "reviewedAt"
          ],
          "properties": {
            "status": {
              "const": "cleared"
            },
            "basis": {
              "enum": [
                "original",
                "licensed"
              ]
            },
            "notes": {
              "type": "string",
              "minLength": 1
            },
            "licenseReference": {
              "type": "string"
            },
            "reviewedBy": {
              "type": "string",
              "minLength": 1
            },
            "reviewedAt": {
              "$ref": "#/$defs/timestamp"
            }
          }
        },
        "qa": {
          "type": "object",
          "required": [
            "content",
            "pedagogy",
            "technical",
            "experience"
          ],
          "properties": {
            "content": {
              "$ref": "#/$defs/gate"
            },
            "pedagogy": {
              "$ref": "#/$defs/gate"
            },
            "technical": {
              "$ref": "#/$defs/gate"
            },
            "experience": {
              "$ref": "#/$defs/gate"
            }
          }
        }
      }
    }
  }
}
